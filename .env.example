# Use the supplied Iteration 1 CSV files by default.
REACH_DATA_SOURCE=csv

# Use the original static frontend demonstration data if required.
# REACH_DATA_SOURCE=demo

# Enable these values after running db:migrate and db:import.
# REACH_DATA_SOURCE=database
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Password-free local socket used by the EC2 development deployment:
# DATABASE_URL=postgresql:///serinea?host=/var/run/postgresql
