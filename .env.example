# The deployed AWS RDS database is required at runtime.
REACH_DATA_SOURCE=database
DATABASE_URL=postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/serinea?sslmode=require&uselibpqcompat=true

# Coursework-review Basic Authentication. Keep real values only in .env.local
# or the deployment secret store; never commit credentials.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=replace_with_a_private_password


# Free-tier Groq chat for the Compare assistant (do not commit real keys).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Server-side Hugging Face Inference Providers credentials.
AI_REVIEW_MODEL_VERSION=qwen3-4b-instruct-2507-hf-router-v1
AI_REVIEW_POLICY_VERSION=serinea-review-v1
AI_REVIEW_TIMEOUT_MS=8000
# Alternative to AI_REVIEW_BASE_URL: Hugging Face Inference Providers.
HF_TOKEN=hf_your_server_only_token
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
