# The deployed AWS RDS database is required at runtime.
REACH_DATA_SOURCE=database
DATABASE_URL=postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/serinea?sslmode=require&uselibpqcompat=true

# Coursework-review Basic Authentication. Keep real values only in .env.local
# or the deployment secret store; never commit credentials.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=replace_with_a_private_password


# Free-tier Groq chat for the Compare assistant (do not commit real keys).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Dedicated Hugging Face endpoint for the SERINEA Qwen3-0.6B review service.
# The Hub model repository is not an inference URL. Create/deploy an endpoint first.
HF_ENDPOINT_URL=https://YOUR_ENDPOINT.endpoints.huggingface.cloud
# HF_TOKEN is accepted as a backwards-compatible fallback during migration.
HF_ENDPOINT_TOKEN=hf_your_server_only_endpoint_token
AI_REVIEW_MODEL_VERSION=qwen3-0.6b-g2-q4f16-v1
AI_REVIEW_POLICY_VERSION=serinea-review-v1
# When a scaled-to-zero endpoint is loading, retry 502/503/504 responses for up to 3 minutes.
AI_REVIEW_COLD_START_TIMEOUT_MS=180000
AI_REVIEW_TIMEOUT_MS=60000
